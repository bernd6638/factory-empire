# Kopieren nach .env (wird NICHT eingecheckt) oder als Umgebungsvariablen setzen.
# Alternativ: verschlüsselter Tresor -> python -m trading_system vault set ALPACA_API_KEY

# Marktdaten (optional – ohne Schlüssel: Yahoo (verzögert) -> Simulation)
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPHAVANTAGE_API_KEY=

# KI-Kommentare über Claude (optional, zusätzlich TS_LLM_ENABLED=true)
ANTHROPIC_API_KEY=
TS_LLM_ENABLED=false

# Passwort für den verschlüsselten Tresor data/secrets.vault
TS_VAULT_PASSWORD=

# Beispiele für Konfigurations-Overrides
TS_SYMBOLS=AAPL,MSFT,NVDA,SPY,QQQ
TS_DATA_PROVIDER=auto
TS_LOOP_INTERVAL_SEC=60
