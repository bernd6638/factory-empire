{
  "name": "server",
  "version": "1.0.0",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "dev": "dotenv -e ../.env -- prisma migrate deploy && tsx watch --clear-screen=false src/index.ts",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "dotenv -e ../.env -- prisma migrate deploy && node dist/index.js",
    "start:bot": "node dist/index.js bot",
    "start:api": "node dist/index.js api",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:deploy": "dotenv -e ../.env -- prisma migrate deploy",
    "db:migrate": "dotenv -e ../.env -- prisma migrate dev",
    "db:studio": "dotenv -e ../.env -- prisma studio",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "connect-redis": "8.1.0",
    "cron-parser": "5.10.4",
    "discord.js": "14.28.1",
    "dotenv": "16.6.1",
    "dotenv-cli": "8.0.0",
    "express": "5.3.0",
    "express-rate-limit": "7.5.1",
    "express-session": "1.19.0",
    "helmet": "8.3.0",
    "ioredis": "5.11.1",
    "pino": "9.14.0",
    "pino-pretty": "13.2.0",
    "prisma": "6.19.3",
    "rate-limit-redis": "4.3.1",
    "ws": "8.22.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/express-session": "1.19.0",
    "@types/node": "22.20.5",
    "@types/ws": "8.18.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.0.18"
  }
}
