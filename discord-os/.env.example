# ─────────────────────────────────────────────────────────────
#  Discord OS – Konfiguration
#  Kopiere diese Datei nach ".env" und trage deine Werte ein.
#  Die Datei .env darf NIEMALS veröffentlicht werden.
# ─────────────────────────────────────────────────────────────

NODE_ENV=production

# Discord-Anwendung (https://discord.com/developers/applications)
DISCORD_TOKEN=dein-bot-token
DISCORD_CLIENT_ID=deine-client-id
DISCORD_CLIENT_SECRET=dein-client-secret

# Optional: Slash-Commands sofort nur auf diesem Server registrieren (Entwicklung).
# Leer lassen = globale Registrierung (kann bis zu 1 Stunde dauern).
DEV_GUILD_ID=

# Privilegierter Presence-Intent (muss im Developer-Portal aktiviert sein).
# Ohne ihn werden Online-Zahlen über die Discord-API geschätzt (approximate_presence_count).
ENABLE_PRESENCE_INTENT=false

# Datenbank & Redis
DATABASE_URL=postgresql://discordos:discordos@localhost:5432/discordos?schema=public
REDIS_URL=redis://localhost:6379

# Öffentliche Adresse, unter der das Dashboard im Browser aufgerufen wird.
#  - Produktion / start.bat:  http://localhost:3001
#  - Entwicklung (npm run dev): http://localhost:5173
# Die Redirect-URL in Discord muss lauten: <PUBLIC_URL>/api/auth/callback
PUBLIC_URL=http://localhost:3001

API_HOST=0.0.0.0
API_PORT=3001

# Hinter einem Reverse-Proxy (nginx, Caddy, Cloudflare) auf true setzen.
TRUST_PROXY=false

# Mindestens 32 zufällige Zeichen. Wird von "npm run setup" automatisch erzeugt.
SESSION_SECRET=
# 64 Hex-Zeichen (32 Byte) für die Verschlüsselung gespeicherter OAuth-Tokens.
ENCRYPTION_KEY=

# Discord-User-IDs (kommagetrennt), die auf allen Servern des Bots volle Rechte im Dashboard haben.
BOT_OWNER_IDS=

# trace | debug | info | warn | error
LOG_LEVEL=info
